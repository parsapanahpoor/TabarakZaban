@using SharedProject.Application.Extensions
@model Identity.Application.User.Queries.FilterUsers.FilterUsersDto

@{
    ViewData["Title"] = "نمایش لیست کاربران";
}

@section Styles
{
}

@section Scripts
{
}

@section Breadcrumb
{
    <li>
        <a href="javascript:void(0)"> @ViewData["Title"] </a>
    </li>
}

<div class="row">
    <div class="col-lg-3 col-sm-12">
        <div class="widget">
            <div class="widget-header bordered-bottom bordered-green">
                <span class="widget-caption"> نمایش لیست کاربران </span>
            </div>
            <div class="widget-body">
                <div>
                    <form asp-action="FilterUsers" asp-controller="User" asp-area="Admin" id="filter-search" method="get">

                        <input type="hidden" asp-for="Page" />

                        <div class="form-group">
                            <label asp-for="Mobile"> موبایل </label>
                            <input type="text" class="form-control" asp-for="Mobile">
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-12 flex-style">
                                <button type="submit" class="btn btn-labeled w-100 btn-palegreen">
                                    <i class="btn-label glyphicon glyphicon-filter"></i>ثبت
                                </button>

                                @if (Context.Request.QueryString.HasValue)
                                {
                                    <a asp-action="FilterUsers" asp-controller="User" asp-area="Admin" class="btn btn-labeled w-100 btn-darkorange ">
                                        <i class="btn-label glyphicon glyphicon-remove"></i>حذف فیلتر
                                    </a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9 col-sm-12">
        <div class="well with-header with-footer table-responsive tableFixHead">
            <div class="header bordered-azure">
                <div class="flex-style">
                    <span>عنوان صفحه </span>
                    <span class="red p-5">(@Model.GetShownEntitiesPagesTitle())</span><span>نفر</span>
                </div>
            </div>

            @if (Model.Entities != null && Model.Entities.Any())
            {
                <table class="table table-hover table-bordered tc vm">
                    <thead class="tc vm">
                        <tr class="tc vm">
                            <th class="tc vm">
                                آواتار
                            </th>
                            <th class="tc vm">
                                موبایل
                            </th>>
                            <th class="tc vm">
                                امکانات
                            </th>
                        </tr>
                    </thead>
                    <tbody class="tc vm">
                        @foreach (var user in Model.Entities)
                        {
                            <tr class="tc vm">
                                <td class="vm">
                                    <div class="flex-style-center">
                                        <img src="@user.UserAvatar.GetUserAvatar()" class="avatar-style" />
                                    </div>
                                </td>
                                <td class="tc vm">
                                    <p> @user.PhoneNumber</p>
                                </td>
                                <td class="tc vm">
                                    <a asp-action="AccountDetail"
                                       asp-controller="Account"
                                       asp-area="Admin"
                                       asp-route-id="@user.Id"
                                       class="btn btn-azure btn-circle btn-xs"><i class="glyphicon glyphicon-eye-open"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="footer tc">

                    <partial name="_AdminPaging" model="@Model.GetCurrentPaging()" />

                </div>
            }
            else
            {
                <partial name="_AdminNotFoundPartial" />
            }
        </div>
    </div>
</div>

